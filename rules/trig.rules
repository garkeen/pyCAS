# trigonometric identities
# sin_neg/cos_neg 已退役：奇偶性规则由 FunctionSpec 自动生成（origin='spec'）
rule sin2_cos2 = sin(?x)^2 + cos(?x)^2 -> 1
rule sin_add = sin(?a)*cos(?b) + cos(?a)*sin(?b) -> sin(?a+?b)
rule cos_diff = cos(?a)*cos(?b) + sin(?a)*sin(?b) -> cos(?a-?b)
rule tan_def = tan(?x) -> sin(?x)/cos(?x)
